# ADOMS 앱 3400 — 환경변수 이름 목록(값은 비워 둔다). 코드의 process.env.* 를 모두 모은 것이다(2026-09-26).
# 이 파일을 .env.local 로 복사해 값을 채운다. .env.local 은 git 에 올리지 않는다(.gitignore).

# ── 데이터 판 폴더(비우면 코드 기본값 ../../../../30_데이터/_수집작업/ADOMS_DB_v1/_데모_용인시_20260920 를 찾는다) ──
# us_* · ops_* · lawtext_* · law_sync · _agent 가 들어 있는 폴더. 09-26 결정으로 저장소 안 data/ 에 함께 올렸다 —
# 저장소 폴더에서 실행하면 아래 값(상대 경로) 그대로 쓴다. 다른 곳에 두면 그 절대 경로를 적는다. 비밀값 아님.
ADOMS_OPS_DIR=./data/_데모_용인시_20260920

# ── Supabase(비우면 CSV 판 + 덮개 파일 모드로 돈다) ──
# 둘 다 채우면 읽기·쓰기가 Supabase REST(스키마 adoms2)로 간다. anon(publishable) 키만 쓴다 — service_role 키는 앱에 넣지 않는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 올린 파일을 넣을 Storage 버킷 이름(비우면 evidence)
NEXT_PUBLIC_SUPABASE_BUCKET=

# ── 메일(SMTP) — SMTP_HOST 와 MAIL_FROM 이 없으면 메일은 「설정 안 됨」으로 남고 보내지 않는다 ──
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=
SMTP_TLS_REJECT_UNAUTHORIZED=
SMTP_ALLOW_PLAIN_AUTH=

# ── 서버·주소 ──
# 휴대폰 QR 등에 쓰는 바깥 주소(배포했으면 그 주소)
NEXT_PUBLIC_BASE_URL=
# 서버 포트(법령 개정 확인 파이썬이 앱으로 돌아올 주소에 쓴다 · lib/lan.ts 기본 3100 · lib/lawsync.ts 기본 3400)
PORT=
# 빌드 결과 폴더(윈도 운영 모드 아이콘은 .next-prod 를 쓴다 · 비우면 .next)
NEXT_DIST_DIR=
# 법령 개정 확인에 쓸 파이썬 실행 파일(비우면 윈도 pythonw · 그 밖 python)
ADOMS_PYTHON=
