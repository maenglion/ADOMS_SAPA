{"doc_id":"DOC-004931","title":"청소년수련시설 종합평가 운영규정","norm_form":"notice","effective_from":"20260907","last_amended_at":"20260907","nlic_mst":"2100000284830","units":[{"u":"UNIT-0414417","p":"a1","l":"제1조","t":"article","d":"1","ti":"목적","x":"제1조(목적) 이 규정은 「청소년활동 진흥법」(이하 \"법\"이라 한다) 제19조의2 및 같은 법 시행규칙 제9조의2에 따른 수련시설 종합평가 운영에 관하여 필요한 사항을 정하는 것을 목적으로 한다.","e":"20260907","del":""},{"u":"UNIT-0414418","p":"a2","l":"제2조","t":"article","d":"1","ti":"정의","x":"제2조(정의) 이 규정에서 사용하는 용어 정의는 다음과 같다.","e":"20260907","del":""},{"u":"UNIT-0414419","p":"a2/n1","l":"제2조제1호","t":"item","d":"3","ti":"정의","x":"1. \"청소년수련시설\"이란 법 제10조제1호 각 목에 따른 청소년수련시설(이하 \"수련시설\"이라 한다)을 말한다.","e":"20260907","del":""},{"u":"UNIT-0414420","p":"a2/n2","l":"제2조제2호","t":"item","d":"3","ti":"정의","x":"2. \"청소년수련시설 종합평가(이하 \"평가\"라 한다)\"란 법 제19조의2에 따른 평가로서 수련시설 운영 및 관리 체계, 활동 프로그램 운영 등 수련시설 전반에 대한 평가를 말한다.","e":"20260907","del":""},{"u":"UNIT-0414421","p":"a2/n3","l":"제2조제3호","t":"item","d":"3","ti":"정의","x":"3. \"정량평가\"란 평가지표에 따른 실적에 대한 양적인 평가를 말한다.","e":"20260907","del":""},{"u":"UNIT-0414422","p":"a2/n4","l":"제2조제4호","t":"item","d":"3","ti":"정의","x":"4. \"정성평가\"란 평가지표에 따른 실적과 수련시설의 전반적인 상태 등에 대해 평가위원의 판단에 의한 질적인 평가를 말한다.","e":"20260907","del":""},{"u":"UNIT-0414423","p":"a3","l":"제3조","t":"article","d":"1","ti":"평가계획의 수립","x":"제3조(평가계획의 수립) 성평등가족부장관은 평가대상 시설이 평가를 준비할 수 있도록 매년 평가 종료 전에 다음 평가에 대한 대상 및 기간, 평가추진 체계, 평가절차, 평가결과 활용, 평가지표 등을 포함한 평가기본계획을 수립하여 공표하여야 한다.","e":"20260907","del":""},{"u":"UNIT-0414424","p":"a4","l":"제4조","t":"article","d":"1","ti":"평가수행기관","x":"제4조(평가수행기관)","e":"20260907","del":""},{"u":"UNIT-0414425","p":"a4/p1","l":"제4조제1항","t":"para","d":"2","ti":"평가수행기관","x":"① 성평등가족부 장관은 제3조의 업무를 효율적으로 추진하기 위해 사전에 평가수행기관을 지정한다.","e":"20260907","del":""},{"u":"UNIT-0414426","p":"a4/p2","l":"제4조제2항","t":"para","d":"2","ti":"평가수행기관","x":"② 평가수행기관은 국책연구기관, 공공기관, 청소년수련시설관련 비영리법인 등을 공동으로 지정하여 운영할 수 있다. 이 경우 평가전반을 관리할 수 있는 책임자 1명을 지정한다.","e":"20260907","del":""},{"u":"UNIT-0414427","p":"a4/p3","l":"제4조제3항","t":"para","d":"2","ti":"평가수행기관","x":"③ 평가수행기관의 역할은 다음 각 호의 사항을 수행한다.","e":"20260907","del":""},{"u":"UNIT-0414428","p":"a4/p3/n1","l":"제4조제3항제1호","t":"item","d":"3","ti":"평가수행기관","x":"1. 평가심의위원회 구성ㆍ운영지원","e":"20260907","del":""},{"u":"UNIT-0414429","p":"a4/p3/n2","l":"제4조제3항제2호","t":"item","d":"3","ti":"평가수행기관","x":"2. 평가위원 위촉 및 교육","e":"20260907","del":""},{"u":"UNIT-0414430","p":"a4/p3/n3","l":"제4조제3항제3호","t":"item","d":"3","ti":"평가수행기관","x":"3. 평가지표 개발 및 관리","e":"20260907","del":""},{"u":"UNIT-0414431","p":"a4/p3/n4","l":"제4조제3항제4호","t":"item","d":"3","ti":"평가수행기관","x":"4. 평가결과 분석 및 사후관리","e":"20260907","del":""},{"u":"UNIT-0414432","p":"a4/p3/n5","l":"제4조제3항제5호","t":"item","d":"3","ti":"평가수행기관","x":"5. 평가대상 시설의 컨설팅 및 평가교육 등","e":"20260907","del":""},{"u":"UNIT-0414433","p":"a4/p3/n6","l":"제4조제3항제6호","t":"item","d":"3","ti":"평가수행기관","x":"6. 기타 평가와 관련된 업무","e":"20260907","del":""},{"u":"UNIT-0414434","p":"a5","l":"제5조","t":"article","d":"1","ti":"평가수행기관의 변경","x":"제5조(평가수행기관의 변경)","e":"20260907","del":""},{"u":"UNIT-0414435","p":"a5/p1","l":"제5조제1항","t":"para","d":"2","ti":"평가수행기관의 변경","x":"① 성평등가족부 장관은 평가수행기관(수탁법인 포함)에서 다음 각 호의 사유가 발생한 경우 평가수행기관을 변경할 수 있다.","e":"20260907","del":""},{"u":"UNIT-0414436","p":"a5/p1/n1","l":"제5조제1항제1호","t":"item","d":"3","ti":"평가수행기관의 변경","x":"1. 성평등가족부 또는 평가수행기관이 계약해지를 원할 때","e":"20260907","del":""},{"u":"UNIT-0414437","p":"a5/p1/n2","l":"제5조제1항제2호","t":"item","d":"3","ti":"평가수행기관의 변경","x":"2. 천재지변 등으로 이 계약관계를 유지할 수 없는 사유가 발생한 때","e":"20260907","del":""},{"u":"UNIT-0414438","p":"a5/p1/n3","l":"제5조제1항제3호","t":"item","d":"3","ti":"평가수행기관의 변경","x":"3. 평가수행기관 수탁법인의 법인격이 소멸된 때","e":"20260907","del":""},{"u":"UNIT-0414439","p":"a5/p1/n4","l":"제5조제1항제4호","t":"item","d":"3","ti":"평가수행기관의 변경","x":"4. 평가수행기관이 계약내용을 이행하지 않을 때","e":"20260907","del":""},{"u":"UNIT-0414440","p":"a5/p1/n5","l":"제5조제1항제5호","t":"item","d":"3","ti":"평가수행기관의 변경","x":"5. 평가수행기관이 수탁목적을 수행할 능력이 없다고 인정될 때","e":"20260907","del":""},{"u":"UNIT-0414441","p":"a5/p1/n6","l":"제5조제1항제6호","t":"item","d":"3","ti":"평가수행기관의 변경","x":"6. 수탁법인이 관계법령을 준수하지 않을 때","e":"20260907","del":""},{"u":"UNIT-0414442","p":"a5/p1/n7","l":"제5조제1항제7호","t":"item","d":"3","ti":"평가수행기관의 변경","x":"7. 그밖에 성평등가족부 장관이 필요하다고 인정할 때","e":"20260907","del":""},{"u":"UNIT-0414443","p":"a5/p2","l":"제5조제2항","t":"para","d":"2","ti":"평가수행기관의 변경","x":"② 위탁기간의 만료 또는 제1항의 사유로 평가수행기관이 변경되는 경우 업무를 수행했던 기존 평가수행기관은 신규 지정된 평가수행기관에게 평가수행기관관련 자료 및 업무 일체를 성실히 인계하여야 하며 인계ㆍ인수서를 작성하여 상호 보관한다.","e":"20260907","del":""},{"u":"UNIT-0414444","p":"a6","l":"제6조","t":"article","d":"1","ti":"평가심의위원회 구성 및 운영","x":"제6조(평가심의위원회 구성 및 운영)","e":"20260907","del":""},{"u":"UNIT-0414445","p":"a6/p1","l":"제6조제1항","t":"para","d":"2","ti":"평가심의위원회 구성 및 운영","x":"① 성평등가족부장관은 평가사업의 투명성 및 신뢰성 제고와 효율적 운영을 위하여 평가심의위원회(이하 ‘심의위원회’라 한다.)를 구성ㆍ운영 한다.","e":"20260907","del":""},{"u":"UNIT-0414446","p":"a6/p2","l":"제6조제2항","t":"para","d":"2","ti":"평가심의위원회 구성 및 운영","x":"② 심의위원회는 위원장과 당연직 위원을 포함하여 10명 이내로 구성한다.","e":"20260907","del":""},{"u":"UNIT-0414447","p":"a6/p3","l":"제6조제3항","t":"para","d":"2","ti":"평가심의위원회 구성 및 운영","x":"③ 위원의 임기는 1년으로 하되 연임할 수 있고, 보궐위원의 임기는 전임자의 잔여기간으로 한다.","e":"20260907","del":""},{"u":"UNIT-0414448","p":"a6/p4","l":"제6조제4항","t":"para","d":"2","ti":"평가심의위원회 구성 및 운영","x":"④ 위원은 평가위원 중 청소년분야의 경험과 연륜이 높은 사람 중 성평등가족부와 협의를 거쳐 평가수행기관의 장이 위촉한다.","e":"20260907","del":""},{"u":"UNIT-0414449","p":"a6/p5","l":"제6조제5항","t":"para","d":"2","ti":"평가심의위원회 구성 및 운영","x":"⑤ 위원장은 위원 중 호선하며 심의위원회를 대표하고 심의위원회의 직무를 총괄한다.","e":"20260907","del":""},{"u":"UNIT-0414450","p":"a6/p6","l":"제6조제6항","t":"para","d":"2","ti":"평가심의위원회 구성 및 운영","x":"⑥ 위원장이 부득이한 사유로 직무를 수행할 수 없는 경우에는 위원회에서 미리 정한 위원이 위원장의 직무를 대행하며 지체 없이 위원장을 선출한다. 다만 임기 만료가 2개월 이내일 경우에는 보선하지 아니할 수 있다.","e":"20260907","del":""},{"u":"UNIT-0414451","p":"a6/p7","l":"제6조제7항","t":"para","d":"2","ti":"평가심의위원회 구성 및 운영","x":"⑦ 청소년활동안전과장은 당연위원으로 한다.","e":"20260907","del":""},{"u":"UNIT-0414452","p":"a6/p8","l":"제6조제8항","t":"para","d":"2","ti":"평가심의위원회 구성 및 운영","x":"⑧ 간사는 평가수행기관이 하며 의결권을 가지지 않는다.","e":"20260907","del":""},{"u":"UNIT-0414453","p":"a6/p9","l":"제6조제9항","t":"para","d":"2","ti":"평가심의위원회 구성 및 운영","x":"⑨ 심의위원회는 반기별 정기회의를 개최하며, 임시회의는 위원 4분의 1이상의 요청이 있거나 위원장이 필요하다고 인정할 때에 소집한다.","e":"20260907","del":""},{"u":"UNIT-0414454","p":"a6/p10","l":"제6조제10항","t":"para","d":"2","ti":"평가심의위원회 구성 및 운영","x":"⑩ 회의는 재적위원 과반수의 출석으로 개의하고, 출석위원 과반수의 찬성으로 의결한다.","e":"20260907","del":""},{"u":"UNIT-0414455","p":"a6/p11","l":"제6조제11항","t":"para","d":"2","ti":"평가심의위원회 구성 및 운영","x":"⑪ 심의위원회는 다음 각 호의 사항을 의결한다.","e":"20260907","del":""},{"u":"UNIT-0414456","p":"a6/p11/n1","l":"제6조제11항제1호","t":"item","d":"3","ti":"평가심의위원회 구성 및 운영","x":"1. 평가지표 및 평가편람 심의ㆍ확정에 관한 사항","e":"20260907","del":""},{"u":"UNIT-0414457","p":"a6/p11/n2","l":"제6조제11항제2호","t":"item","d":"3","ti":"평가심의위원회 구성 및 운영","x":"2. 평가대상 및 평가제외시설의 확정에 관한 사항","e":"20260907","del":""},{"u":"UNIT-0414458","p":"a6/p11/n3","l":"제6조제11항제3호","t":"item","d":"3","ti":"평가심의위원회 구성 및 운영","x":"3. 평가등급 및 평가거부시설 확정에 관한 사항","e":"20260907","del":""},{"u":"UNIT-0414459","p":"a6/p11/n4","l":"제6조제11항제4호","t":"item","d":"3","ti":"평가심의위원회 구성 및 운영","x":"4. 평가등급 조정에 관한 사항","e":"20260907","del":""},{"u":"UNIT-0414460","p":"a6/p11/n5","l":"제6조제11항제5호","t":"item","d":"3","ti":"평가심의위원회 구성 및 운영","x":"5. 성평등가족부장관이 부의한 사항과 평가운영에 관한 사항","e":"20260907","del":""},{"u":"UNIT-0414461","p":"a7","l":"제7조","t":"article","d":"1","ti":"평가위원","x":"제7조(평가위원)","e":"20260907","del":""},{"u":"UNIT-0414462","p":"a7/p1","l":"제7조제1항","t":"para","d":"2","ti":"평가위원","x":"① 평가수행기관은 객관적이고 공정한 평가를 위하여 다음 각 호의 청소년관련전문가를 평가위원으로 위촉하여야 한다. 이 경우 현재 청소년수련시설에 종사하는 자는 제외한다.","e":"20260907","del":""},{"u":"UNIT-0414463","p":"a7/p1/n1","l":"제7조제1항제1호","t":"item","d":"3","ti":"평가위원","x":"1. 청소년관련 학과 재직교수","e":"20260907","del":""},{"u":"UNIT-0414464","p":"a7/p1/n2","l":"제7조제1항제2호","t":"item","d":"3","ti":"평가위원","x":"2. 청소년관련 연구기관 등의 경력 3년 이상의 연구원","e":"20260907","del":""},{"u":"UNIT-0414465","p":"a7/p1/n3","l":"제7조제1항제3호","t":"item","d":"3","ti":"평가위원","x":"3. 청소년육성 경력 10